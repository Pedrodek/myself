# Copy to .env for local development. Never commit real values.
# All variables use the HUB_ prefix (see app/core/config.py).

HUB_ENV=dev
# Required in prod (>= 32 chars). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HUB_SECRET_KEY=
HUB_SITE_URL=http://127.0.0.1:8000
HUB_DATABASE_URL=sqlite+aiosqlite:///./data/hub.db
HUB_CONTENT_DIR=content
HUB_DEFAULT_LOCALE=pt

# GitHub integration (token is optional but raises the API quota from 60 to 5000 req/h)
HUB_GITHUB_USER=
HUB_GITHUB_TOKEN=
HUB_GITHUB_OFFLINE=false

# Optional webhook notified on new contact messages
HUB_NOTIFY_WEBHOOK_URL=

# Reverse proxy
HUB_TRUSTED_PROXIES=127.0.0.1
HUB_COOKIE_SECURE=

HUB_LOG_LEVEL=INFO
# rich (dev default) or json (prod default)
HUB_LOG_FORMAT=
